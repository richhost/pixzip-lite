{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"isolatedModules": true,
		"moduleDetection": "force",
		"esModuleInterop": true,
		"lib": ["ESNext"],
		"strict": true,
		"skipLibCheck": true,
		"types": ["bun-types"]
	},
	"include": [
		"./src/bun/**/*.ts",
		"./src/shared/**/*.ts",
		"./src/types/*.d.ts",
		"./electrobun.config.ts",
		"./scripts/**/*.ts"
	]
}
