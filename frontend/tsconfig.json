{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "noEmit": true,
    /** TS ignores the ./offline sub-directory's package.json, so point at its type entry manually */
    "paths": {
      "@iconify/svelte/offline": ["./node_modules/@iconify/svelte/dist/offline.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte", "bindings"],
  "exclude": ["src/locales/.wuchale"],
}
